# --- data ---
# Raw and processed data are NEVER committed. They are large, they are
# regenerable from the fetch modules, and Elexon/NESO licence terms cover
# redistribution. The repo must contain the code that produces the data,
# not the data itself.
data/raw/
data/processed/
*.parquet
 
# --- outputs that are regenerated by run_all.py ---
# Figures are the one debatable case. reports/figures/ stays tracked so the
# README renders on GitHub without cloning and running the pipeline.
# reports/figures/    <- deliberately NOT ignored
 
# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
 
# --- tooling ---
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
 
# --- secrets ---
.env
*.key
secrets.yaml
 
# --- editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
 