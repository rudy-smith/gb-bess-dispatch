# --- data ---
# Raw and processed data are never committed. They are large, they are
# regenerable from the fetch modules, and Elexon/NESO licence terms cover
# redistribution. The repo contains the code that produces the data, not
# the data itself.
data/raw/
data/processed/
*.parquet

# --- outputs ---
# Figures and quality reports are regenerated by the pipeline from the
# cached raw data. The three figures referenced by the README are kept so
# the page renders on GitHub without cloning and running anything.
reports/figures/*
reports/quality/*
!reports/figures/dispatch_*.png
!reports/figures/degradation_frontier.png
!reports/figures/sensitivity_duration_efficiency.png

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- tooling ---
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# --- secrets ---
.env
*.key
secrets.yaml

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
